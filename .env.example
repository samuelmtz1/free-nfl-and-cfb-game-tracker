# BallDontLie API Key (For NFL Games)
# Get a free key at: https://app.balldontlie.io
BALLDONTLIE_API_KEY=your_balldontlie_api_key_here

# College Football Data (CFBD) API Key (For CFB Games)
# Get a free key at: https://collegefootballdata.com/key
CFBD_API_KEY=your_cfbd_api_key_here
